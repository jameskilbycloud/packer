# =============================================================================
# GitHub secrets + variables for the Packer pipeline.
#
# HOW TO USE
#   1. Copy this file to .secrets.env   (that name is gitignored — never commit)
#   2. Fill in the values below (annotations are on their OWN lines; value lines
#      must have nothing after the `=`, no trailing spaces, no inline comments).
#   3. Seed GitHub:  bash scripts/seed-github-secrets.sh
#      Preview only:  bash scripts/seed-github-secrets.sh --dry-run
#
# Blank values are SKIPPED (any existing value already in GitHub is left as-is),
# so you can re-run this after filling in just a few more keys.
#
# Everything in the "VARIABLES" section is set as a repo *variable* (vars.*);
# everything else is set as a repo *secret* (secrets.*). GITHUB_TOKEN is never
# set here — GitHub provides it automatically.
# =============================================================================

# ── Required — vCenter connection ────────────────────────────────────────────
VSPHERE_SERVER=
VSPHERE_USER=
VSPHERE_PASSWORD=
VSPHERE_DATACENTER=
VSPHERE_DATASTORE=
VSPHERE_NETWORK=
# Datastore OR Content Library name holding the ISOs.
VSPHERE_ISO_LIBRARY_DATASTORE=

# ── Required — exactly ONE of these (cluster preferred; host for a standalone ESXi) ──
VSPHERE_CLUSTER=
VSPHERE_HOST=

# ── Required — build credentials ─────────────────────────────────────────────
# Plaintext password Packer uses for the build SSH connection.
BUILD_PASSWORD=
# SHA-512 hash for autoinstall. Generate:  openssl passwd -6 'YourBuildPassword'
BUILD_PASSWORD_ENCRYPTED=

# ── Optional secrets (leave blank to accept the default / skip) ──────────────
# default: packer
VSPHERE_FOLDER=
# default: false
VSPHERE_INSECURE=
# default: ubuntu
BUILD_USERNAME=
# Persistent admin account to create in the image (blank = skip).
ADMIN_USERNAME=
# GitHub username whose SSH keys are imported for ADMIN_USERNAME (blank = skip).
ADMIN_GITHUB_USER=
# Slack incoming-webhook URL for build notifications (blank = skip).
SLACK_WEBHOOK_URL=

# ── Repo VARIABLES (set via `gh variable set`, not secrets) ──────────────────
# default: Packer-ISOs
CONTENT_LIBRARY=
# default: self-hosted
RUNNER_LABEL=
# default: 2
TEMPLATE_RETENTION_COUNT=
# default: false
TEMPLATE_PRUNE_DRY_RUN=
# default: same as CONTENT_LIBRARY
TEMPLATE_CONTENT_LIBRARY=
# default: 30
QUARANTINE_RETAIN_DAYS=
# default: 60
PREFLIGHT_MIN_FREE_GB=
